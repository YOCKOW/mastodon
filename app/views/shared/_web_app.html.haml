- content_for :body_classes, 'app-body'
- content_for :header_tags do
  - if user_signed_in?
    %meta{ name: 'initialPath', content: request.path }

  %meta{ name: 'applicationServerKey', content: Rails.configuration.x.vapid.public_key }

  = render_initial_state
  = vite_typescript_tag 'application.ts', crossorigin: 'anonymous'
  = vite_typescript_tag 'yockow-customization.ts', crossorigin: 'anonymous'

  -# Google Tag Manager for yMastodon/ひあるびどん
  / Google Tag Manager
  %script{ nonce: request.content_security_policy_nonce }
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TKF8DMJP');
  / End Google Tag Manager

-# haml-lint:disable InlineStyles
/ Google Tag Manager (noscript)
%noscript
  %iframe{
    src: 'https://www.googletagmanager.com/ns.html?id=GTM-TKF8DMJP',
    height: '0', width: '0',
    style: 'display:none;visibility:hidden',
    nonce: request.content_security_policy_nonce
  }
/ End Google Tag Manager (noscript)
-# haml-lint:enable InlineStyles

.notranslate.app-holder#mastodon{ data: { props: Oj.dump(default_props) } }
  %noscript
    = image_tag frontend_asset_path('images/logo.svg'), alt: 'Mastodon'

    %div
      = t('errors.noscript_html', apps_path: 'https://joinmastodon.org/apps')
